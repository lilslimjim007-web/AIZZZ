# Battle Arena config — copy to .env and edit

# Port the server runs on
PORT=5001

# How many minutes out matches get scheduled once 4 players ready up
MATCH_DELAY_MINUTES=30

# Players must confirm ("ready up") this many minutes before start or lose their spot
CONFIRM_CUTOFF_MINUTES=5

# Google Sign-In: create an OAuth Client ID at https://console.cloud.google.com/apis/credentials
# (type: Web application, add your app's URL to "Authorized JavaScript origins")
# Leave blank to let players use Quick Join only.
GOOGLE_CLIENT_ID=
